--- !u!114 &4175146285262365812
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5052998684102664141}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "* \uBAA9\uD45C: \uC804\uCCB4 \uC9C0\uC5ED\uC744 \uBAA8\uB450 \uC810\uB839\uD558\uBA74
    \uC2B9\uB9AC\uD569\uB2C8\uB2E4. \uBC18\uB300\uB85C \uBAA8\uB4E0 \uC9C0\uC5ED\uC744
    \uC783\uC744 \uC2DC \uD328\uBC30\uD569\uB2C8\uB2E4.\n\r\n* \uD134 \uC9C4\uD589:
    \uD134 \uC885\uB8CC\uB97C \uB204\uB974\uBA74 \uBAA8\uB4E0 \uC608\uC57D\uB41C
    \uBA85\uB839\uC744 \uCC98\uB9AC\uD558\uACE0 \uB2E4\uC74C\uD134\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4.\n\r\n*
    \uC0DD\uC0B0: \uB0B4 \uC9C0\uC5ED\uC740 \uD134 \uC2DC\uC791\uB9C8\uB2E4 \uBCD1\uB825\uC774
    \uC99D\uAC00\uD569\uB2C8\uB2E4. \uB808\uBCA8\uC774 \uB192\uC744\uC218\uB85D \uB354
    \uB9CE\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\r\n* \uC9C0\uC815: \uD55C \uC9C0\uC5ED\uC5D0\uB294
    \uB9E4 \uD134\uB9C8\uB2E4 \uD589\uB3D9\uC744 \uD558\uB098\uB9CC \uC9C0\uC815\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\r\n* \uD589\uB3D9: \uB300\uAE30 / \uBC29\uC5B4\uD0DC\uC138
    \uC804\uD658\xB7\uD574\uC81C / \uC774\uB3D9 / \uC5C5\uADF8\uB808\uC774\uB4DC\n\r\n*
    \uB300\uAE30: \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
    \uAE30\uBCF8 \uBCD1\uC0AC\uB294 \uC0DD\uC131\uB429\uB2C8\uB2E4.\n\r\n* \uBC29\uC5B4\uD0DC\uC138:
    \uB4E4\uC5B4\uC624\uB294 \uD53C\uD574\uB97C \uC77C\uBD80 \uC904\uC785\uB2C8\uB2E4.
    \uC720\uC9C0 \uC911\uC5D0\uB294 \uC774\uB3D9\uACFC \uC5C5\uADF8\uB808\uC774\uB4DC
    \uBA85\uB839\uC744 \uC218\uD589\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uD574\uC81C\uD55C
    \uD134\uC5D0 \uB3C4\uCC29\uD55C \uACF5\uACA9\uC5D0\uB294 \uC801\uC6A9\uB418\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\n\r\n* \uC774\uB3D9: \uBAA9\uC801\uC9C0\uB97C \uD0ED\uD558\uACE0
    \uBCF4\uB0BC \uBCD1\uB825\uC744 \uC815\uD569\uB2C8\uB2E4. \uB2E4\uC74C \uD134\uC5D0
    \uB3C4\uCC29\uD558\uBA70, \uC544\uAD70 \uC9C0\uC5ED\uC5D0 \uAC08 \uACBD\uC6B0
    \uD569\uB958\uD569\uB2C8\uB2E4.\n\r\n* \uC5C5\uADF8\uB808\uC774\uB4DC: \uBCD1\uB825\uC744
    \uC18C\uBAA8\uD574 \uB808\uBCA8\uC744 \uC62C\uB9BD\uB2C8\uB2E4. \uCD5C\uB300\uB808\uBCA8\uC740
    10\uC774\uBA70, \uB808\uBCA8\uC744 \uC62C\uB9B4\uC218\uB85D \uAE30\uBCF8 \uBCD1\uC0AC
    \uC0DD\uC0B0\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\r\n* \uC8FC\uC758: \uC5C5\uADF8\uB808\uC774\uB4DC\uB294
    \uD574\uB2F9 \uC9C0\uC5ED\uC5D0 \uADC0\uC18D\uB429\uB2C8\uB2E4. \uB2E4\uC2DC\uB9D0\uD574,
    \uC801\uC774 \uC5C5\uADF8\uB808\uC774\uB4DC\uB41C \uB545\uC744 \uBE8F\uC5B4\uB3C4
    \uC5C5\uADF8\uB808\uC774\uB4DC\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\r\n* \uC804\uD22C:
    \uACF5\uACA9\uACFC \uBC29\uC5B4\uAC00 \uB9DE\uBD80\uB52A\uD600 \uB354 \uAC15\uD55C
    \uCABD\uC774 \uB0A8\uC2B5\uB2C8\uB2E4. \uC2B9\uB9AC\uD558\uBA74 \uB0A8\uC740
    \uBCD1\uB825\uC774 \uADF8 \uC9C0\uC5ED\uC744 \uC810\uB839\uD569\uB2C8\uB2E4."
